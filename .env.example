# ============================================================
# NEXSAI Manager 3.0 — Environment Configuration Template
# ============================================================
# Copy this file to `.env.local` for local development.
# On Vercel, configure these in Project Settings -> Environment Variables.
# NEVER commit `.env.local` or real tokens to Git.

# Required for Instagram: Instagram User Access Token (Instagram API with Instagram Login)
INSTAGRAM_ACCESS_TOKEN=

# Required for Threads: Threads User Access Token (Meta Threads API v1.0, graph.threads.net)
THREADS_ACCESS_TOKEN=

# Optional (For Meta Threads Webhook Signature Verification & Subscription at /api/webhooks/threads):
# THREADS_APP_SECRET=
# THREADS_WEBHOOK_VERIFY_TOKEN=

# Optional (Recommended for Vercel Production when using header-capable MCP clients):
# Secret key to protect the public `/api/mcp` endpoint.
# When set, MCP clients must send `Authorization: Bearer <MCP_API_KEY>`
# or `x-mcp-api-key: <MCP_API_KEY>`.
# MCP_API_KEY=

# Optional (Cloud Relational Persistence via Supabase PostgreSQL):
# When unset, NEXSAI Manager 3.0 automatically uses its durable JSON store.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
