# ============================================================
# NEXSAI Manager 2.0 — Environment Configuration Template
# ============================================================
# Copy this file to `.env.local` for local development.
# On Vercel, configure these in Project Settings -> Environment Variables.
# NEVER commit `.env.local` or real tokens to Git.

# Required: Instagram User Access Token (Instagram API with Instagram Login)
INSTAGRAM_ACCESS_TOKEN=

# Optional (Recommended for Vercel Production when using header-capable MCP clients):
# Secret key to protect the public `/api/mcp` endpoint.
# When set, MCP clients must send `Authorization: Bearer <MCP_API_KEY>`
# or `x-mcp-api-key: <MCP_API_KEY>`.
# MCP_API_KEY=

# Optional (Cloud Relational Persistence via Supabase PostgreSQL):
# When unset, NEXSAI Manager 2.0 automatically uses its durable JSON store.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
